# Variables de entorno (copiar a .env.local para trabajar en local; en
# producción viven en Vercel → Settings → Environment variables).
# NUNCA commitear las reales: .env* está ignorado excepto este archivo.

# --- Planificador IA (capa de texto) ---------------------------------------
# Key de Groq (gratis, sin tarjeta): https://console.groq.com/keys
# Si no está, el planificador funciona igual con el texto del motor.
GROQ_API_KEY=
# Opcional: cambiar el modelo. El 20b es el doble de rápido; el 120b escribe mejor.
GROQ_MODEL=openai/gpt-oss-120b

# --- Ya usadas en producción ------------------------------------------------
# Token de Mercado Pago (creación de preferencias y verificación de pagos)
MP_ACCESS_TOKEN=
# Enlaces de los materiales, un solo enlace o JSON { "slug": "https://..." }
MATERIAL_LINKS=
# Código que habilita las descargas del planificador
PLANIFICADOR_CODIGO=
